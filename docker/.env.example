# 中间件密码配置模板
# 使用方法：复制此文件为 .env，并填入你的实际密码
# cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_password

# Redis
REDIS_PASSWORD=your_redis_password

# 对象存储配置
# 本地开发：docker compose --profile minio up -d
# 使用 B2 则不需要本地 MinIO

# MinIO (本地开发)
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

# Backblaze B2 (云存储，可选)
# 在 application-dev.yml 中配置：
#   minio.endpoint: https://s3.us-west-002.backblazeb2.com
#   minio.access-key: <Application Key ID>
#   minio.secret-key: <Application Key>
#   minio.region: us-west-002
# B2 区域参考：us-west-002, us-east-005, eu-central-003, ap-003

# Kafka - 填入你的服务器公网IP
KAFKA_PUBLIC_IP=your_server_public_ip