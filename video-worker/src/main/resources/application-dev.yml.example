# 开发环境配置模板
# 使用方法：复制此文件为 application-dev.yml，并填入本地实际配置
# cp application-dev.yml.example application-dev.yml

# 数据源配置（与API共享）
spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:13306/video_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD
    druid:
      initial-size: 5
      min-idle: 5
      max-active: 20

  # Redis配置
  data:
    redis:
      host: localhost
      port: 16379
      password: YOUR_REDIS_PASSWORD
      database: 0


# MinIO配置
minio:
  endpoint: http://localhost:9000
  access-key: YOUR_MINIO_ACCESS_KEY
  secret-key: YOUR_MINIO_SECRET_KEY
  bucket-name: video-ai
  region: us-east-1

# 当前三阶段模型；ASR和文本客户端默认复用此API Key。
ai:
  provider: dashscope
  dashscope:
    api-key: YOUR_DASHSCOPE_API_KEY
    model: qwen3.7-plus
    max-tokens: 4096
    timeout: 300
    connect-timeout: 30
    presigned-url-expire-hours: 2

analysis:
  asr:
    model: qwen-audio-3.0-asr-flash-filetrans
  text:
    model: qwen3.8-flash
  media:
    # 若不在PATH中，请填写FFmpeg/FFprobe可执行文件绝对路径。
    ffmpeg: ffmpeg
    ffprobe: ffprobe

videoai:
  rag:
    vector:
      base-url: http://localhost:19530
      collection: apex_knowledge_chunk
    embedding:
      provider: dashscope
      base-url: https://dashscope.aliyuncs.com/api/v1
      api-key: YOUR_DASHSCOPE_API_KEY
      model: text-embedding-v3
      dimension: 1024
      dashscope:
        text-type: document

# 仅模拟通知，不向真实邮箱发送。先执行 V2.2 SQL；API 与 Worker 同时开启。
notification:
  mock:
    enabled: false
  kafka:
    bootstrap-servers: localhost:9092
    topic: video.analysis.finished.v1
